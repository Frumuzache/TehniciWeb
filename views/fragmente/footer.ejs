<footer id="contact">
  <!-- <address> este elementul semantic pentru informații de contact -->
  <address>
    Telefon: <a href="tel:+40111222333">+40 111 222 333</a><br>
    Adresă: Str. Exemplu nr. 10,<br>
    Corp C, etaj 2, București,<br>
    România —
    <a href="https://www.google.com/maps?q=Facultatea+de+Matematica+si+Informatica+Universitatea+din+Bucuresti"
      target="_blank" rel="noopener noreferrer">deschide în Google Maps</a><br>
