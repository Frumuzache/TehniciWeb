<header>
  <!-- aria-hidden="true" pe iconițe: nu sunt citite de screen readere (decorative) -->
  <h1>
    <i class="fa-solid fa-microchip" aria-hidden="true"></i>
    Magazin de piese de robotica
    <i class="fa-solid fa-gear fa-spin-pulse" aria-hidden="true"></i>
  </h1>
  <img src="/resurse/imagini/Arduino_Uno_-_R3.jpg" alt="Placă Arduino Uno" />
  <!-- Navigare cu submeniu dropdown; meniul hamburger este activat din scriptul de mai jos -->
  <nav>
    <div id="hamburger">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <ul>
      <li>
        <a href="/">
          <i class="fa-solid fa-house"></i>
          <span class="meniu-text">Acasă</span>
        </a>
        <ul>
          <li><a href="#welcome">Prezentare</a></li>
          <li><a href="#evenimente">Evenimente</a></li>
        </ul>
      </li>
      <li>
        <a href="/produse">
          <i class="fa-solid fa-boxes-stacked"></i>
          <span class="meniu-text">Produse</span>
        </a>
        <ul>
          <li><a href="/produse">Toate</a></li>
          <% if (typeof categorii !== 'undefined') { %>
            <% for (const cat of categorii) { %>
              <li><a href="/produse?categorie=<%= cat %>"><%= cat.charAt(0).toUpperCase() + cat.slice(1) %></a></li>
            <% } %>
          <% } %>
          <li><a href="/seturi"><i class="fa-solid fa-layer-group"></i> Seturi</a></li>
        </ul>
      </li>
      <li>
        <a href="/#catalog">
          <i class="fa-solid fa-book-open"></i>
          <span class="meniu-text">Catalog</span>
        </a>
        <ul>
          <li><a href="/galerie">Galerie statică</a></li>
          <li><a href="/galerie-dinamica">Galerie dinamică</a></li>
        </ul>
      </li>
      <li>
        <a href="/#contact">
          <i class="fa-solid fa-envelope"></i>
          <span class="meniu-text">Contact</span>
        </a>
        <ul>
          <li><a href="/#index-intrebari">Întrebări frecvente</a></li>
          <li><a href="/#resurse-video">Video</a></li>
        </ul>
      </li>
      <li>
        <a href="/about">
          <i class="fa-solid fa-circle-info"></i>
          <span class="meniu-text">Despre</span>
        </a>
      </li>
    </ul>
  </nav>

  <!-- Bonus 2: Selector teme cromatice -->
  <div class="selectorTema" role="group" aria-label="Selectare temă">
    <span class="tema-label"><i class="fa-solid fa-palette" aria-hidden="true"></i> Temă:</span>

    <input type="radio" class="btn-check" name="tema-radio" id="tema-luminos" value="luminos" autocomplete="off">
    <label class="btn btn-outline-secondary btn-sm" for="tema-luminos" title="Temă luminoasă">
      <i class="fa-solid fa-sun" aria-hidden="true"></i> Luminos
    </label>

    <input type="radio" class="btn-check" name="tema-radio" id="tema-dark" value="dark" autocomplete="off">
    <label class="btn btn-outline-secondary btn-sm" for="tema-dark" title="Temă întunecată">
      <i class="fa-solid fa-moon" aria-hidden="true"></i> Întunecat
    </label>

    <input type="radio" class="btn-check" name="tema-radio" id="tema-verde" value="verde" autocomplete="off">
    <label class="btn btn-outline-success btn-sm" for="tema-verde" title="Temă verde">
      <i class="fa-solid fa-leaf" aria-hidden="true"></i> Verde
    </label>

    <button id="btn-tema" title="Comutare temă luminoasă / întunecată" aria-label="Comutare temă">
      <i class="fa-solid fa-moon" aria-hidden="true"></i>
    </button>
  </div>

  <!-- Zona utilizator: login sau info cont -->
  <div id="zona-user">
    <% if (locals.utilizator) { %>
      <div id="info-user">
        <% if (utilizator.poza) { %>
          <img src="/poze_uploadate/<%= utilizator.poza %>" alt="Poza profil" class="poza-profil-mic" />
        <% } else { %>
          <i class="fa-solid fa-circle-user" aria-hidden="true"></i>
        <% } %>
        <span class="user-salut">
          Salut, <strong><%= utilizator.prenume || utilizator.username %></strong>!
        </span>
        <% if (utilizator.rol !== 'comun') { %>
          <span class="badge-rol badge-rol--<%= utilizator.rol %>"><%= utilizator.rol %></span>
        <% } %>
        <a href="/profil" class="btn-user">Profil</a>
        <% if (locals.Drepturi && utilizator.areDreptul(Drepturi.vizualizareUtilizatori)) { %>
          <a href="/useri" class="btn-user">Utilizatori</a>
        <% } %>
        <a href="/logout" class="btn-user btn-user--logout">Deconectare</a>
      </div>
    <% } else { %>
      <% if (locals.mesajLogin) { %>
        <p class="mesaj-login-eroare"><%= mesajLogin %></p>
      <% } %>
      <form action="/login" method="POST" id="form-login-header">
        <input type="text" name="username" placeholder="Username" required autocomplete="username" />
        <input type="password" name="parola" placeholder="Parolă" required autocomplete="current-password" />
        <button type="submit"><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i> Autentificare</button>
      </form>
      <a href="/inregistrare" class="btn-user btn-user--inreg">Cont nou</a>
    <% } %>
  </div>
</header>
<script>
  /* Meniu hamburger: toggle clasa 'active' la click, închidere la click în afara navului */
  (function () {
    var hamburger = document.getElementById('hamburger');
    var nav = hamburger.closest('nav');

    hamburger.addEventListener('click', function (e) {
      e.stopPropagation();
      nav.classList.toggle('active');
    });

    document.addEventListener('click', function (e) {
      if (!nav.contains(e.target)) {
        nav.classList.remove('active');
      }
    });
  })();
</script>
