<!DOCTYPE html>
<html lang="ro">

<head>
  <%- include('../fragmente/head') %>
  <link rel="stylesheet" href="/resurse/css/produse.css" type="text/css" />
  <title>Produse | Magazin de piese de robotică</title>
</head>

<body id="inceput-pagina" data-tip-pagina="produse">

  <%- include('../fragmente/header') %>

  <main id="main-produse" class="container-fluid px-3 px-md-4 py-4">

    <h2 id="titlu-produse">
      <% if (categorieSelectata) { %>
        Produse &mdash; <%= categorieSelectata.charAt(0).toUpperCase() + categorieSelectata.slice(1) %>
      <% } else { %>
        Toate produsele
      <% } %>
      <small class="text-muted fs-6 ms-2">(<span id="nr-produse-afisate">0</span> produse afișate)</small>
    </h2>

    <!-- Bonus 12: Banner ofertă curentă -->
    <div id="banner-oferta" hidden>
      <i class="bi bi-tag-fill"></i>
      <strong>Ofertă activă:</strong>
      <span id="banner-oferta-categorie"></span>
      — reducere <span id="banner-oferta-reducere"></span>%!
    </div>

    <!-- ═══ SECȚIUNEA DE FILTRE ═══ -->
    <div id="sectiune-filtre" class="p-3 p-md-4 mb-4 rounded-3 border">

      <h3 class="fs-6 fw-bold text-uppercase mb-3" style="letter-spacing:.06em;">Filtre și sortare</h3>

      <div class="row g-3">

        <!-- 1. TEXT: protocol -->
        <div class="col-12 col-md-6 col-lg-3">
          <label class="form-label small fw-semibold" for="filtru-protocol">Protocol conținut:</label>
          <input type="text" class="form-control form-control-sm" id="filtru-protocol"
                 placeholder="ex: I2C, SPI...">
        </div>

        <!-- 2. RANGE: preț maxim -->
        <div class="col-12 col-md-6 col-lg-4">
          <label class="form-label small fw-semibold text-body">Preț maxim (RON):</label>
          <div class="d-flex align-items-center gap-2">
            <span id="pret-min-label" class="small text-body-secondary">0</span>
            <input type="range" class="form-range flex-grow-1" id="filtru-pret" min="0" max="300" value="300">
            <span id="pret-max-label" class="small text-body-secondary">300</span>
            <span id="pret-valoare-curenta" class="small fw-bold text-body" style="white-space:nowrap;">(300 RON)</span>
          </div>
        </div>

        <!-- 3. DATALIST: greutate maximă -->
        <div class="col-12 col-md-6 col-lg-3">
          <label class="form-label small fw-semibold" for="filtru-greutate">Greutate maximă (g):</label>
          <input type="text" class="form-control form-control-sm" id="filtru-greutate"
                 list="lista-greutati" placeholder="oricare">
          <datalist id="lista-greutati"></datalist>
        </div>

        <!-- 4. RADIO: disponibilitate — toggle buttons Bootstrap -->
        <div class="col-12 col-md-6 col-lg-2">
          <p class="form-label small fw-semibold mb-2">Disponibilitate:</p>
          <div class="btn-group w-100" role="group" aria-label="Disponibilitate">
            <input type="radio" class="btn-check" name="in_stoc" id="stoc-oricare" value="oricare" checked autocomplete="off">
            <label class="btn btn-outline-secondary btn-sm" for="stoc-oricare">Oricare</label>

            <input type="radio" class="btn-check" name="in_stoc" id="stoc-da" value="da" autocomplete="off">
            <label class="btn btn-outline-success btn-sm" for="stoc-da">În stoc</label>

            <input type="radio" class="btn-check" name="in_stoc" id="stoc-nu" value="nu" autocomplete="off">
            <label class="btn btn-outline-danger btn-sm" for="stoc-nu">Epuizat</label>
          </div>
        </div>

        <!-- 5. CHECKBOX: subcategorie — toggle buttons Bootstrap -->
        <div class="col-12">
          <p class="form-label small fw-semibold mb-2">Subcategorie:</p>
          <div class="btn-group flex-wrap" role="group" aria-label="Subcategorie">
            <% for (const sc of subcategorii) { %>
              <input type="checkbox" class="btn-check cb-subcategorie"
                     id="sc-<%= sc %>" value="<%= sc %>" checked autocomplete="off">
              <label class="btn btn-outline-primary btn-sm" for="sc-<%= sc %>">
                <%= sc.replace('_', ' ') %>
              </label>
            <% } %>
          </div>
        </div>

        <!-- 6. TEXTAREA: cuvânt cheie în descriere — floating label -->
        <div class="col-12 col-md-6">
          <div class="form-floating">
            <textarea class="form-control" id="filtru-descriere"
                      placeholder="ex: Bluetooth, IoT..." style="height:80px;"></textarea>
            <label for="filtru-descriere">Cuvânt cheie în descriere</label>
            <div class="invalid-feedback">
              Câmpul conține doar spații. Introduceți un cuvânt valid sau lăsați gol.
            </div>
          </div>
        </div>

        <!-- 7. SELECT SIMPLU: compatibilitate -->
        <div class="col-12 col-md-6 col-lg-3">
          <label class="form-label small fw-semibold" for="filtru-compat">Compatibilitate:</label>
          <select id="filtru-compat" class="form-select form-select-sm">
            <option value="">oricare</option>
            <% for (const cp of compatibilitati) { %>
              <option value="<%= cp %>"><%= cp %></option>
            <% } %>
          </select>
        </div>

        <!-- 8. SELECT MULTIPLU: excludere protocoale -->
        <div class="col-12 col-md-6 col-lg-5">
          <label class="form-label small fw-semibold" for="filtru-proto-exclude">
            Selectați valorile pe care NU le doriți:
          </label>
          <select id="filtru-proto-exclude" class="form-select form-select-sm" multiple size="4">
            <option value="I2C">I2C</option>
            <option value="SPI">SPI</option>
            <option value="UART">UART</option>
            <option value="PWM">PWM</option>
            <option value="ADC">ADC</option>
            <option value="USB">USB</option>
            <option value="Bluetooth">Bluetooth</option>
            <option value="CAN">CAN</option>
            <option value="1-Wire">1-Wire</option>
            <option value="analogic">analogic</option>
            <option value="digital">digital</option>
          </select>
        </div>

      </div><!-- /.row -->

      <!-- ═══ BUTOANE PRINCIPALE ═══ -->
      <div id="butoane-filtre" class="d-flex flex-wrap gap-2 mt-3">

        <button id="btn-filtreaza" class="btn btn-primary btn-sm">
          <i class="bi bi-funnel-fill"></i>
          <span class="d-none d-sm-inline"> Filtrează</span>
        </button>

        <button id="btn-sort-asc" class="btn btn-secondary btn-sm">
          <i class="bi bi-sort-up"></i>
          <span class="d-none d-sm-inline"> Sortare crescătoare</span>
        </button>

        <button id="btn-sort-desc" class="btn btn-secondary btn-sm">
          <i class="bi bi-sort-down"></i>
          <span class="d-none d-sm-inline"> Sortare descrescătoare</span>
        </button>

        <button id="btn-calcul" class="btn btn-warning btn-sm">
          <i class="bi bi-calculator-fill"></i>
          <span class="d-none d-sm-inline"> Calculează</span>
        </button>

        <button id="btn-reset" class="btn btn-outline-danger btn-sm">
          <i class="bi bi-arrow-counterclockwise"></i>
          <span class="d-none d-sm-inline"> Resetare</span>
        </button>

        <!-- Bonus 10: Filtrare server -->
        <button id="btn-filtreaza-server" class="btn btn-sm">
          <i class="bi bi-cloud-arrow-down-fill"></i>
          <span class="d-none d-sm-inline"> Filtrare server</span>
        </button>

      </div>

      <!-- ═══ SORTARE AVANSATĂ — Bonus 8 ═══ -->
      <div id="sectiune-sortare-multipla" class="mt-3 pt-3">
        <h4 class="fs-6 fw-semibold mb-2" style="color:var(--culoare-primara);">
          <i class="bi bi-sort-alpha-down"></i> Sortare avansată (chei multiple)
        </h4>
        <div id="randuri-sortare">
          <div class="rand-sortare d-flex align-items-center gap-2 mb-2 flex-wrap">
            <select class="form-select form-select-sm select-sort-camp" style="max-width:160px;">
              <option value="">— câmp —</option>
              <option value="pret">Preț</option>
              <option value="greutate">Greutate</option>
              <option value="subcategorie">Subcategorie</option>
              <option value="compatibilitate">Compatibilitate</option>
              <option value="data_adaugare">Dată adăugare</option>
              <option value="nume">Nume</option>
            </select>
            <select class="form-select form-select-sm select-sort-dir" style="max-width:140px;">
              <option value="asc">Crescător ↑</option>
              <option value="desc">Descrescător ↓</option>
            </select>
            <button type="button" class="btn btn-sm btn-outline-secondary btn-sterge-rand" title="Elimină rândul">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
          <div class="rand-sortare d-flex align-items-center gap-2 mb-2 flex-wrap">
            <select class="form-select form-select-sm select-sort-camp" style="max-width:160px;">
              <option value="">— câmp —</option>
              <option value="pret">Preț</option>
              <option value="greutate">Greutate</option>
              <option value="subcategorie">Subcategorie</option>
              <option value="compatibilitate">Compatibilitate</option>
              <option value="data_adaugare">Dată adăugare</option>
              <option value="nume">Nume</option>
            </select>
            <select class="form-select form-select-sm select-sort-dir" style="max-width:140px;">
              <option value="asc">Crescător ↑</option>
              <option value="desc">Descrescător ↓</option>
            </select>
            <button type="button" class="btn btn-sm btn-outline-secondary btn-sterge-rand" title="Elimină rândul">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
          <button id="btn-sort-multiple" class="btn btn-primary btn-sm">
            <i class="bi bi-sort-alpha-down"></i>
            <span class="d-none d-sm-inline"> Aplică sortare avansată</span>
          </button>
          <button id="btn-adauga-rand" type="button" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-plus-lg"></i>
            <span class="d-none d-sm-inline"> Adaugă cheie</span>
          </button>
          <!-- Bonus 3 Etapa 7: Salvare filtrare -->
          <div class="form-check ms-2 mb-0">
            <input class="form-check-input" type="checkbox" id="cb-salveaza-filtrare">
            <label class="form-check-label small fw-semibold" for="cb-salveaza-filtrare">
              <i class="bi bi-floppy"></i> Salvează filtrarea
            </label>
          </div>
        </div>
      </div>

      <div id="mesaj-validare" class="alert alert-danger mt-2 py-2 px-3 small" role="alert" hidden></div>

    </div><!-- /#sectiune-filtre -->

    <!-- Bonus 5: Controale paginare (deasupra gridului) -->
    <div id="controale-paginare">
      <label for="select-k">Produse per pagină:</label>
      <select id="select-k">
        <option value="5">5</option>
        <option value="10" selected>10</option>
        <option value="all">Toate</option>
      </select>
    </div>

    <!-- ═══ GRID PRODUSE ═══ -->
    <div id="grid-produse">

      <!-- Bonus 3: mesaj cand filtrarea nu gaseste produse -->
      <div id="mesaj-filtru-gol" class="mesaj-gol w-100" hidden>
        <i class="bi bi-search"></i> Nu există produse conform filtrării curente.
      </div>

      <% for (const prod of produse) { %>
        <article
          id="ar_ent_<%= prod.id %>"
          class="produs <%= prod.categorie %> <%= prod.subcategorie %>"
          data-id="<%= prod.id %>"
          data-pret="<%= prod.pret %>"
          data-greutate="<%= prod.greutate %>"
          data-subcategorie="<%= prod.subcategorie %>"
          data-compatibilitate="<%= prod.compatibilitate %>"
          data-protocoale="<%= prod.protocoale ? prod.protocoale.join(',') : '' %>"
          data-in-stoc="<%= prod.in_stoc ? 'da' : 'nu' %>"
          data-descriere="<%= (prod.descriere || '').toLowerCase().replace(/"/g, '&quot;') %>"
          data-data-adaugare="<%= new Date(prod.data_adaugare).toISOString() %>"
          data-nume="<%= (prod.nume || '').replace(/"/g, '&quot;') %>"
          data-categorie="<%= prod.categorie %>"
          data-imagine="<%= prod.imagine %>"
        >
          <h3><a href="/produs/<%= prod.id %>"><%= prod.nume %></a></h3>

          <div class="produs-coloane">
            <!-- Coloana 1: categorie, imagine, descriere -->
            <div class="col-stanga">
              <p class="badge-categorie <%= prod.categorie %>"><%= prod.categorie %></p>
              <img
                src="/resurse/imagini/produse/<%= prod.imagine %>"
                alt="<%= prod.nume %>"
                class="produs-imagine"
                onerror="this.src='/resurse/imagini/produse/placeholder.svg'"
              >
              <p class="produs-descriere"><%= prod.descriere %></p>
            </div>

            <!-- Coloana 2: caracteristici -->
            <div class="col-dreapta">
              <p>
                <strong class="eticheta">Preț:</strong>
                <span class="valoare pret-valoare"><%= parseFloat(prod.pret).toFixed(2) %> RON</span>
              </p>
              <p>
                <strong class="eticheta">Compatibilitate:</strong>
                <span class="valoare"><%= prod.compatibilitate %></span>
              </p>
              <p>
                <strong class="eticheta">Protocoale:</strong>
                <span class="valoare">
                  <%= prod.protocoale && prod.protocoale.length ? prod.protocoale.join(', ') : '—' %>
                </span>
              </p>
              <p>
                <strong class="eticheta">Adăugat:</strong>
                <time
                  datetime="<%= new Date(prod.data_adaugare).toISOString().split('T')[0] %>"
                  class="valoare"
                >
                  <%= formatDataRo(prod.data_adaugare) %>
                </time>
              </p>
              <p>
                <strong class="eticheta">În stoc:</strong>
                <span class="valoare stoc-<%= prod.in_stoc ? 'da' : 'nu' %>">
                  <%= prod.in_stoc ? '✓ Da' : '✗ Nu' %>
                </span>
              </p>
              <p>
                <strong class="eticheta">Greutate:</strong>
                <span class="valoare"><%= prod.greutate %> g</span>
              </p>
            </div>
          </div>

          <!-- Bonus 6: Butoane acțiuni produs -->
          <div class="butoane-produs">
            <button class="btn-actiune btn-salveaza" title="Salvează/fixează produsul">
              <i class="bi bi-bookmark-fill"></i>
            </button>
            <button class="btn-actiune btn-sterge-temp" title="Ascunde temporar">
              <i class="bi bi-trash3"></i>
            </button>
            <button class="btn-actiune btn-sterge-sesiune" title="Ascunde pe tot parcursul sesiunii">
              <i class="bi bi-x-circle-fill"></i>
            </button>
          </div>

          <!-- Bonus 20: Buton comparare -->
          <button class="btn-compara" title="Adaugă la comparare"
                  data-id="<%= prod.id %>"
                  data-nume="<%= (prod.nume || '').replace(/"/g, '&quot;') %>"
                  data-pret="<%= prod.pret %>"
                  data-compatibilitate="<%= prod.compatibilitate %>"
                  data-protocoale="<%= prod.protocoale ? prod.protocoale.join(',') : '' %>"
                  data-in-stoc="<%= prod.in_stoc ? 'da' : 'nu' %>"
                  data-greutate="<%= prod.greutate %>"
                  data-imagine="<%= prod.imagine %>">
            <i class="bi bi-arrow-left-right"></i> Compară
          </button>

          <a href="/produs/<%= prod.id %>" class="link-detalii">
            <i class="bi bi-info-circle-fill"></i> Detalii complete
          </a>
        </article>
      <% } %>

      <% if (produse.length === 0) { %>
        <p class="mesaj-gol">Nu există produse în această categorie.</p>
      <% } %>

    </div><!-- /#grid-produse -->

    <!-- Bonus 5: Butoane pagini (sub grid) -->
    <div id="butoane-pagini"></div>

  </main>

  <!-- Bonus 11: Modal detalii produs -->
  <div class="modal fade" id="modal-produs" tabindex="-1" aria-labelledby="modal-produs-titlu-label" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header" style="background:var(--culoare-primara,#1d3557);color:#fff;">
          <h5 class="modal-title" id="modal-produs-titlu-label"></h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Închide"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-4 text-center">
              <img id="modal-produs-imagine" src="" alt="" class="img-fluid rounded"
                   style="max-height:200px;object-fit:cover;border:1px solid var(--culoare-bordura);">
            </div>
            <div class="col-md-8">
              <table class="table table-sm table-borderless mb-1">
                <tbody>
                  <tr>
                    <th style="color:var(--culoare-primara);width:40%;">Preț:</th>
                    <td id="modal-produs-pret" class="fw-bold" style="color:var(--culoare-accent,#d4a017);"></td>
                  </tr>
                  <tr>
                    <th style="color:var(--culoare-primara);">Compatibilitate:</th>
                    <td id="modal-produs-compat"></td>
                  </tr>
                  <tr>
                    <th style="color:var(--culoare-primara);">Protocoale:</th>
                    <td id="modal-produs-protocoale"></td>
                  </tr>
                  <tr>
                    <th style="color:var(--culoare-primara);">În stoc:</th>
                    <td id="modal-produs-stoc"></td>
                  </tr>
                  <tr>
                    <th style="color:var(--culoare-primara);">Greutate:</th>
                    <td id="modal-produs-greutate"></td>
                  </tr>
                </tbody>
              </table>
              <p class="text-muted small mb-0" id="modal-produs-descriere"></p>
            </div>
          </div>
        </div>
        <div class="modal-footer" style="background:var(--culoare-zona-2,#f5f9ff);">
          <a id="modal-produs-link" href="#" class="btn btn-sm" target="_blank"
             style="background:var(--culoare-primara,#1d3557);color:#fff;">
            <i class="bi bi-box-arrow-up-right"></i> Pagina produsului
          </a>
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Închide</button>
        </div>
      </div>
    </div>
  </div>

  <a id="link-top" href="#inceput-pagina" title="Mergi la începutul paginii">
    <span class="simbol-top" aria-hidden="true"><span id="triunghi"></span></span>
    <span class="text-link-top">Back to top</span>
  </a>

  <%- include('../fragmente/footer') %>

  <script src="/resurse/js/produse.js"></script>

  <!-- Bonus 12: Ofertă curentă pe pagina produse -->
  <script>
    (function() {
      var bannerOferta   = document.getElementById('banner-oferta');
      var bannerCateg    = document.getElementById('banner-oferta-categorie');
      var bannerReducere = document.getElementById('banner-oferta-reducere');

      function actualizeazaBannerOferta() {
        fetch('/api/oferta-curenta')
          .then(function(r) { return r.json(); })
          .then(function(oferta) {
            if (!oferta || !oferta.categorie) {
              bannerOferta.hidden = true;
              return;
            }
            var acum = new Date();
            var sf   = new Date(oferta.data_finalizare);
            if (sf <= acum) {
              bannerOferta.hidden = true;
              return;
            }
            bannerCateg.textContent    = oferta.categorie;
            bannerReducere.textContent = oferta.reducere;
            bannerOferta.hidden = false;

            // Actualizare prețuri reduse pe articole
            var articoleProds = document.querySelectorAll('#grid-produse .produs');
            articoleProds.forEach(function(art) {
              var pretEl = art.querySelector('.pret-valoare');
              if (!pretEl) return;
              var categ = art.dataset.categorie || art.classList[1];
              if (categ === oferta.categorie) {
                var pretOrig = parseFloat(art.dataset.pret);
                var pretNou  = pretOrig * (1 - oferta.reducere / 100);
                if (!pretEl.querySelector('.pret-vechi')) {
                  pretEl.innerHTML =
                    '<span class="pret-vechi">' + pretOrig.toFixed(2) + ' RON</span>' +
                    '<span class="pret-redus">' + pretNou.toFixed(2) + ' RON</span>';
                }
              } else {
                // Resetare la pret normal daca categoria nu mai e in oferta
                if (pretEl.querySelector('.pret-vechi')) {
                  var pretNorm = parseFloat(art.dataset.pret).toFixed(2);
                  pretEl.innerHTML = pretNorm + ' RON';
                }
              }
            });
          })
          .catch(function() { bannerOferta.hidden = true; });
      }

      actualizeazaBannerOferta();
      setInterval(actualizeazaBannerOferta, 5000);
    })();
  </script>

</body>
</html>
